{
	"name": "pogmail",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "bun run typecheck && oxlint",
		"typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
		"lint": "oxlint",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"deploy": "bun run build && wrangler deploy && bun run db:migrate:remote",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:studio": "drizzle-kit studio",
		"cf-typegen": "wrangler types ./src/worker/worker-configuration.d.ts"
	},
	"cloudflare": {
		"bindings": {
			"CF_TOKEN": {
				"description": "Open [Cloudflare API Tokens](https://dash.cloudflare.com/profile/api-tokens), choose **Create Token → Create Custom Token**, then add: **Zone / Zone / Read**, **Zone / DNS / Edit**, **Zone / Zone Settings / Edit**, **Zone / Email Routing Rules / Edit**, **Zone / Email Sending / Edit**, and **Zone / Analytics / Read**. Administration → Suppressions additionally needs **Account / Email Sending / Edit**. Limit Zone Resources to the domains Pogmail will manage. Paste only the token value here, without `Bearer`."
			}
		}
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/onest": "^5.3.1",
		"@maily-to/core": "0.3.7",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-virtual": "^3.14.10",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-text-align": "^3.31.3",
		"@tiptap/extension-text-style": "^3.31.3",
		"@tiptap/extensions": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.5",
		"lucide-react": "^1.41.0",
		"mimetext": "^3.0.28",
		"motion": "^13.2.0",
		"nanoid": "^6.0.1",
		"next-themes": "^0.4.6",
		"postal-mime": "^3.0.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.8",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.4",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/router-plugin": "^1.168.35",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "^0.31.10",
		"oxlint": "^1.81.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.129.0"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"workerd@1.20260815.1": true,
		"workerd@1.20260903.1": true,
		"core-js-pure": false
	}
}
