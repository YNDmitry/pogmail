{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pogmail-private",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/assetlinks.json"]
  },
  // These public values identify the Android app that is allowed to use
  // Credential Manager with each independently deployed Pogmail instance.
  // Set the release signing fingerprint for each production copy before deploy.
  "vars": {
    "ANDROID_APP_PACKAGE": "com.pogmail.android",
    "ANDROID_APP_SHA256_CERT_FINGERPRINTS": "96:B1:83:3B:A6:CD:08:19:A5:4D:59:0A:0B:A5:D1:50:A7:D3:6A:E6:3D:15:5F:8E:F6:F2:17:0B:BC:28:97:3A"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pogmail",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "pogmail"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND_QUEUE",
        "queue": "pogmail-inbound"
      },
      {
        "binding": "OUTBOUND_QUEUE",
        "queue": "pogmail-outbound"
      },
      {
        "binding": "EXTERNAL_SYNC_QUEUE",
        "queue": "pogmail-external-sync"
      }
    ],
    "consumers": [
      {
        "queue": "pogmail-inbound",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "pogmail-dlq"
      },
      {
        "queue": "pogmail-outbound",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "pogmail-dlq"
      },
      {
        "queue": "pogmail-email-events",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "pogmail-dlq"
      },
      {
        "queue": "pogmail-external-sync",
        "max_batch_size": 5,
        "max_retries": 5,
        "dead_letter_queue": "pogmail-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "pogmail-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "DatabaseBackupWorkflow"
    },
    {
      "name": "pogmail-restore",
      "binding": "RESTORE_WORKFLOW",
      "class_name": "DatabaseRestoreWorkflow"
    }
  ],

  "triggers": { "crons": ["*/5 * * * *", "17 * * * *"] },

  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
