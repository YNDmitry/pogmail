{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postbox",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_NAME": "Pogmail",
    "CF_EMAIL_WORKER_NAME": "postbox"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "postbox",
      "database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE",
      "migrations_dir": "drizzle/migrations"
    },
    {
      "binding": "postbox",
      "database_name": "postbox",
      "database_id": "83debcd5-2518-4838-8f9e-182533da9224",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "postbox-mail"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND_QUEUE",
        "queue": "postbox-inbound"
      },
      {
        "binding": "OUTBOUND_QUEUE",
        "queue": "postbox-outbound"
      }
    ],
    "consumers": [
      {
        "queue": "postbox-inbound",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "postbox-dlq"
      },
      {
        "queue": "postbox-outbound",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "postbox-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "postbox-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "DatabaseBackupWorkflow"
    }
  ],

  "triggers": { "crons": ["17 3 * * *"] },

  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  }
}
