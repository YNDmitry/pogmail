{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pogmail",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pogmail",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "pogmail"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND_QUEUE",
        "queue": "pogmail-inbound"
      },
      {
        "binding": "OUTBOUND_QUEUE",
        "queue": "pogmail-outbound"
      }
    ],
    "consumers": [
      {
        "queue": "pogmail-inbound",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "pogmail-dlq"
      },
      {
        "queue": "pogmail-outbound",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "pogmail-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "pogmail-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "DatabaseBackupWorkflow"
    }
  ],

  "triggers": { "crons": ["17 3 * * *"] },

  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  }
}
